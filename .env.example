# Gemini API keys separated by commas. Create two distinct provider keys.
LLM_API_KEYS=replace_with_key_1,replace_with_key_2
LLM_MODEL=gemini/gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini/gemini-3.5-flash
LLM_TIMEOUT_SECONDS=20
DATABASE_URL=sqlite:///./app.db
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ENABLE_FAILURE_SIMULATION=true

# Frontend build-time URL. For local Docker, keep this value.
VITE_API_BASE_URL=http://localhost:8000
